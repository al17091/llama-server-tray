<service>
  <id>llama-server</id>
  <name>llama-server (Local LLM)</name>
  <description>llama.cpp server background service</description>
  
  <!-- Absolute path to the executable (example value – change to match your environment) -->
  <executable>D:\models\llama\llama-server.exe</executable>
  
  <!-- Arguments: Must be written on a single line (example value – change model path, port, etc. to match your environment) -->
  <arguments>--model "D:\models\gguf\gemma-4-e4b-it-Q8_0.gguf" --port 11434 --n-gpu-layers 999 --ctx-size 131072 --flash-attn on --special --temp 0 --min-p 0.1 --host 0.0.0.0 --n-predict -1</arguments>
  
  <!-- Log output directory specification (Must be outside the <log> tag. %BASE% points to the folder containing this XML) -->
  <logpath>%BASE%\logs</logpath>
  
  <!-- Log rotation settings -->
  <log mode="roll">
    <sizeThreshold>10240</sizeThreshold> <!-- Rotate every 10MB -->
    <keepFiles>5</keepFiles>            <!-- Keep the last 5 logs -->
  </log>
</service>
